# ==============================================================================
# ParkMate Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or service role tokens to version control.

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL, Auth, Storage)
# ------------------------------------------------------------------------------
# 1. Obtain your Project URL and anon public key from:
#    https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 2. SERVER-SIDE ONLY: Service Role Key (Used for atomic operations & seed verification)
#    CRITICAL: Never expose this key with NEXT_PUBLIC_ or send to browser clients.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ------------------------------------------------------------------------------
# Supabase Storage Configuration
# ------------------------------------------------------------------------------
# Storage bucket name for parking space photos and host media
NEXT_PUBLIC_STORAGE_BUCKET_PARKING=parking-photos

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------
# Maps Provider (Mapbox / Google Maps Platform)
# ParkMate includes a built-in vector interactive map fallback when keys are absent
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Payment & Host Payouts (Stripe / Stripe Connect)
# SERVER-SIDE ONLY: Keep strictly on server
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
